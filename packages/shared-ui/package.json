{
  "name": "@knowzy/shared-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./assets": {
      "types": "./dist/assets/manifest.d.ts",
      "import": "./dist/assets/manifest.js",
      "default": "./dist/assets/manifest.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "lint": "eslint src",
    "test": "vitest run --dir src --passWithNoTests"
  },
  "dependencies": {
    "@knowzy/shared-types": "*",
    "lucide-react": "^1.47.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@knowzy/eslint-config": "*",
    "@knowzy/tsconfig": "*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
