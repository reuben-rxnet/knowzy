// Knowzy information model.
//
// Authoritative specification: docs/data-model.md. Where this file and that
// document differ, the document wins and this file is the defect.
//
// Conventions (data-model.md §15):
//   - models singular PascalCase, tables snake_case via @@map
//   - fields camelCase, columns snake_case via @map
//   - native PostgreSQL enums, never plain strings
//   - Decimal -> numeric, never Float, for anything a decision reads
//   - ON DELETE RESTRICT by default; CASCADE only for owned child rows
//
// Actor columns (createdByUserId, modifiedByUserId, and the named actors such
// as approvedByUserId) are plain uuid columns rather than Prisma relations.
// Declaring each as a relation would require ~60 back-relations on User for no
// integrity gain: §14 guarantees a User row is never deleted (DEPROVISIONED
// only), so a dangling actor reference cannot arise. Relations are declared
// where traversal is actually used.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Explicit rather than detected. The container base is Debian 12 (OpenSSL 3);
  // naming the target means the correct engine is always present even if
  // detection fails, which it does on an image without the openssl CLI.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // `vector` is created but unused in release 1 (ADR-008).
  extensions = [pgcrypto, pg_trgm, unaccent, vector]
}

