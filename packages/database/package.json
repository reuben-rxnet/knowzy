{
  "name": "@knowzy/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "lint": "eslint src prisma",
    "test": "vitest run --dir src --passWithNoTests",
    "test:integration": "vitest run --dir test",
    "prisma:generate": "cd ../.. && npm run db:generate",
    "prisma:migrate:deploy": "cd ../.. && npm run db:migrate",
    "prisma:migrate:dev": "cd ../.. && npm run db:migrate:dev",
    "prisma:migrate:status": "cd ../.. && npm run db:migrate:status",
    "prisma:validate": "cd ../.. && npm run db:validate",
    "bootstrap:init-migration": "node scripts/generate-init-migration.mjs",
    "seed": "cd ../.. && npm run db:seed",
    "reset": "cd ../.. && npm run db:reset"
  },
  "dependencies": {
    "@knowzy/configuration": "*",
    "@knowzy/observability": "*",
    "@knowzy/shared-types": "*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@knowzy/eslint-config": "*",
    "@knowzy/tsconfig": "*",
    "prisma": "^6.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
