# Knowzy environment variable contract — environment-and-configuration.md §4.
#
# Copy to .env for local development. .env is git-ignored and scanned by the
# pre-commit secret scanner.
#
# EVERY VALUE BELOW IS INERT (P4). No tenant hostname, site URL, site ID, list
# ID, GUID, or credential appears here, and none is required to run the
# platform locally: `local` uses the mock adapter and the mock question bank,
# so the whole pipeline is exercisable with NO TENANT CREDENTIALS AT ALL (V1).
#
# A variable marked SERVER-SIDE must never be given a PUBLIC_ prefix. Startup
# check 3 fails the process if a PUBLIC_ variable holds a secret-shaped value.

# ---------------------------------------------------------------- required
# local | dev | test | prod. Stamped on every span, log line, and audit event.
KNOWZY_ENV=local

# SERVER-SIDE. Password only in local; deployed environments use managed identity.
DATABASE_URL=postgresql://knowzy:knowzy@localhost:5432/knowzy?schema=public

# `stdio` locally; an internal URL in deployed environments. The MCP server is
# never internet-reachable.
MCP_ENDPOINT=http://localhost:8081

# The only API value a browser receives.
PUBLIC_API_BASE_URL=http://localhost:8080

# --------------------------------------------------- local-only (forbidden elsewhere)
# Startup check 4 fails the process if either is set outside `local`.
MOCK_FIXTURE_ROOT=./fixtures/knowledge
# Comma-separated fault injection, e.g. THROTTLE_LISTING,EXTRACTION_FAIL:SOP-Network-Reset
# MOCK_FAULTS=

# ------------------------------------------------------- deployed environments only
# Leave every line below commented out for local development.
#
# Identity (T-01 … T-05). Values are supplied by the tenant identity team; none
# is known in this repository.
# ENTRA_TENANT_ID=
# ENTRA_API_CLIENT_ID=
# ENTRA_API_AUDIENCE=api://knowzy-api
# ENTRA_AUTHORING_CLIENT_ID=
# ENTRA_LIVE_CLIENT_ID=

# Secrets are REFERENCES, never values. The API never returns one, and no
# secret value is ever stored in PostgreSQL or written to an audit event.
# Format: keyvault://{vault}/secrets/{name}
# KEY_VAULT_URI=https://example-vault.vault.azure.net
# ANTHROPIC_API_KEY_REF=keyvault://example-vault/secrets/anthropic-api-key
# GRAPH_CREDENTIAL_REF=keyvault://example-vault/secrets/graph-credential      # mcp-server ONLY
# ENVELOPE_SIGNING_KEY_REF=keyvault://example-vault/secrets/envelope-signing
# CERTIFICATE_SIGNING_KEY_REF=keyvault://example-vault/secrets/certificate-signing

# Artifact storage — certificates and report exports. Private container; no
# public URL exists.
# BLOB_ACCOUNT_URL=https://example.blob.core.windows.net
# BLOB_CONTAINER=artifacts

# Telemetry. Distinct service name per deployable. Audit is unaffected by its
# absence: audit is a database write inside the state transaction.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=knowzy-api
