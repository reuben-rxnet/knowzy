{
  "name": "knowzy",
  "private": true,
  "version": "0.1.0",
  "description": "Knowzy — AI-powered knowledge proficiency platform. Design baseline in /docs.",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "test": "turbo run test",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,cjs,json,md,yml,yaml}\"",
    "codegen": "npm run -w @knowzy/shared-types codegen",
    "codegen:check": "npm run -w @knowzy/shared-types codegen:check",
    "db:generate": "npm run -w @knowzy/database prisma:generate",
    "db:migrate": "npm run -w @knowzy/database prisma:migrate:deploy",
    "db:migrate:dev": "npm run -w @knowzy/database prisma:migrate:dev",
    "db:seed": "npm run -w @knowzy/database seed",
    "db:reset": "npm run -w @knowzy/database reset",
    "verify": "npm run typecheck && npm run lint && npm run lint:boundaries && npm run codegen:check && npm run test",
    "dev": "turbo run dev --parallel",
    "compose:up": "docker compose -f infrastructure/compose/docker-compose.yml up -d",
    "compose:down": "docker compose -f infrastructure/compose/docker-compose.yml down",
    "compose:logs": "docker compose -f infrastructure/compose/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@knowzy/eslint-config": "*",
    "@knowzy/tsconfig": "*",
    "@types/node": "^22.7.5",
    "dependency-cruiser": "^16.4.2",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
