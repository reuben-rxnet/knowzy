{
  "name": "knowzy",
  "private": true,
  "version": "0.1.0",
  "description": "Knowzy \u2014 AI-powered knowledge proficiency platform. Design baseline in /docs.",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,cjs,json,md,yml,yaml}\"",
    "codegen": "npm run -w @knowzy/shared-types codegen",
    "codegen:check": "npm run -w @knowzy/shared-types codegen:check",
    "audit:gate": "tsx scripts/audit-gate.ts",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed --schema packages/database/prisma/schema.prisma && npm run db:migrate && npm run db:seed",
    "verify": "npm run typecheck && npm run lint && npm run lint:boundaries && npm run codegen:check && npm run test",
    "dev": "turbo run dev --parallel",
    "compose:up": "docker compose -f infrastructure/compose/docker-compose.yml up -d",
    "compose:down": "docker compose -f infrastructure/compose/docker-compose.yml down",
    "compose:logs": "docker compose -f infrastructure/compose/docker-compose.yml logs -f",
    "db:migrate:status": "prisma migrate status --schema packages/database/prisma/schema.prisma",
    "db:validate": "prisma validate --schema packages/database/prisma/schema.prisma",
    "test:packages": "turbo run test",
    "assets:sync": "tsx scripts/sync-design-assets.ts"
  },
  "devDependencies": {
    "@knowzy/eslint-config": "*",
    "@knowzy/tsconfig": "*",
    "@types/node": "^22.7.5",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "^16.4.2",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
