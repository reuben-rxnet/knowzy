# Development base image for the Node services in infrastructure/compose.
#
# Exists for one reason: node:22-bookworm-slim ships neither the `openssl` CLI
# nor libssl, and Prisma detects its query-engine variant by running
# `openssl version`. Without it Prisma warns and falls back to the
# openssl-1.1.x engine on a Debian 12 host that actually has OpenSSL 3 —
# it happens to work, and "happens to work" is not a foundation.
#
# Built once by compose and shared by api, mcp, and jobs, so the install cost
# is paid at build time rather than on every container start.

FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /repo
