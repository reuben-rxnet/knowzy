# Production image for a Next.js deployable: authoring-web, live-web, sync-web.
#
# Three images, never one (ADR-001): the authoring routes are not present in
# the learner's bundle, which is the property that makes the separation
# meaningful rather than cosmetic. The Sync Manager is the third.
#
#   docker build -f infrastructure/docker/Dockerfile.web \
#     --build-arg APP=live-web -t knowzy/live-web .

FROM node:22-bookworm-slim AS deps
WORKDIR /repo
COPY package.json package-lock.json turbo.json ./
COPY tools ./tools
COPY packages ./packages
COPY apps ./apps
# Sources are copied in the build stage; this stage only resolves dependencies.
RUN npm ci --no-audit --no-fund

FROM deps AS build
ARG APP
WORKDIR /repo
COPY . .
# Next needs the browser-safe values at build time. Only PUBLIC_* and the Entra
# client id are ever passed (§4); a server-side variable here would be baked
# into a browser bundle.
ARG PUBLIC_API_BASE_URL
ARG KNOWZY_ENV=prod
ENV PUBLIC_API_BASE_URL=${PUBLIC_API_BASE_URL}
ENV KNOWZY_ENV=${KNOWZY_ENV}
RUN npx turbo run build --filter=@knowzy/${APP}...

FROM node:22-bookworm-slim AS runtime
ARG APP
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# ---------------------------------------------------------------- hardening
#
# The FIRST trivy scan ever run against an image from this repository (2026-09-23,
# sync-web) reported 16 HIGH/CRITICAL findings. Thirteen were not this
# application's dependencies at all: they were npm's own bundled tooling
# (`pacote`, `sigstore`, `tar`, `brace-expansion`, `ip-address`, `picomatch`)
# shipped inside the node image, and three were `libpcre2-8-0` in the base
# layer.
#
# A standalone Next server runs `node server.js`. It needs neither npm nor npx,
# so shipping them is pure attack surface AND pure CVE surface. Both are
# removed, and the base packages are upgraded in the same layer.
#
# This is not the audit gate being widened -- nothing is suppressed. The
# vulnerable code is removed from the image.
USER root
RUN apt-get update \
  && apt-get upgrade -y --no-install-recommends \
  && rm -rf /var/lib/apt/lists/* \
  && rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx

WORKDIR /app
USER node

# `output: 'standalone'` produces a self-contained server plus the minimal
# node_modules it actually needs.
COPY --from=build --chown=node:node /repo/apps/${APP}/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build --chown=node:node /repo/apps/${APP}/public ./apps/${APP}/public

EXPOSE 3000
WORKDIR /app/apps/${APP}
CMD ["node", "server.js"]
